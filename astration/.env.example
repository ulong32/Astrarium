# Astration Environment Configuration

# Base URL for the production game asset CDN
ASSET_SERVER_URL=https://example.com

# Target host for mitmproxy intercept scripts (optional)
TARGET_ASSET_HOST=example.com

# Decryption keys for chart and config files
KEY_CONFIG=your_music_config_key_here
KEY_NOTATION=your_notation_key_here

# Optional: Path to vgmstream-cli executable (if not in system PATH)
# VGMSTREAM_PATH=C:/path/to/vgmstream-cli.exe
